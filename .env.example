# Database
DATABASE_URL=postgresql://gridclass:gridclass@localhost:5432/gridclass

# Redis (optional, gracefully degrades)
REDIS_URL=redis://localhost:6379/0

# API authentication (comma-separated keys for protected endpoints)
# When set, admin and batch endpoints require X-API-Key header.
# When empty, protected endpoints reject all requests unless GCC_AUTH_DISABLED=true.
GCC_API_KEYS=
GCC_AUTH_DISABLED=false

# External data sources
EIA_API_KEY=your_eia_api_key_here
PJM_API_KEY=your_pjm_subscription_key_here
PJM_GIS_USERNAME=
PJM_GIS_PASSWORD=
ISONE_USERNAME=
ISONE_PASSWORD=

# WattCarbon integration (optional)
WATTCARBON_EMAIL=
WATTCARBON_API_KEY=
WATTCARBON_API_URL=https://api.wattcarbon.com
